# Contact form email delivery (Resend — https://resend.com).
# Copy to .env.local for development; set the same variables in your host for production.
# Required in production. In dev, leaving the key or inbox unset just logs notes to the terminal.

# API key from resend.com → API Keys (sending access is enough).
RESEND_API_KEY=
# Inbox that receives the notes.
CONTACT_TO_EMAIL=
# Optional sender. Must use a domain you've verified in Resend, e.g.
#   Vishnu Nadh · Portfolio <notes@vishnunadh.dev>
# Leave unset to use Resend's test sender (only delivers to your own Resend account email).
CONTACT_FROM_EMAIL=
